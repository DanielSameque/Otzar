# Copie este arquivo para .env e ajuste os valores do seu ambiente.
# Nunca versionar o .env.

# Porta do Web Service
PORT=3000

# Origens liberadas no CORS, separadas por vírgula.
# Em desenvolvimento o Flutter Web usa uma porta aleatória, por isso "*".
# Em produção, informar a URL do Site Estático do Render.
CORS_ORIGIN=*

# Conexão com o SQL Server 2025 (local via Docker ou Azure SQL Database).
# Formato do Prisma: sqlserver://HOST:PORTA;chave=valor;...
# Em desenvolvimento local, trustServerCertificate=true aceita o certificado
# autoassinado do container. No Azure SQL, usar encrypt=true e trustServerCertificate=false.
DATABASE_URL=sqlserver://localhost:1433;database=otzar;user=sa;password=Otzar@Dev2025;encrypt=true;trustServerCertificate=true

# Segredo de assinatura do JWT (usado a partir do módulo de Autenticação)
JWT_SECRET=troque-este-valor
